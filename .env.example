# Mistral text generation
MISTRAL_API_KEY=replace_with_your_key
MISTRAL_MODEL=mistral-small-latest

# Employee used by the synchronous AgentLoop MCP gateway demo
SWIFTRAIL_EMPLOYEE_ID=1

# MySQL MCP server
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=swiftrail_db
DB_USER=swiftrail_app
DB_PASSWORD=replace_with_your_local_password

# Qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=swiftrail_documents

# Optional local runtime stores
MEMORY_DB_PATH=memory/memory_store.db
